#include <stdio.h>
#define MAX 5
int a[MAX];
int top = -1;
void push()
{
    int val;
    if (top == MAX - 1)
    {
        printf("Stack Overflow\n");
    }
    else
    {
        printf("Enter the element:");
        scanf("%d", &val);
        top++;
        a[top] = val;
        printf("%d pushed to stack\n", val);
    }
}
void pop()
{
    if (top == -1)
    {
        printf("Stack Underflow\n");
    }
    else
    {
        printf("%d popped from stack\n", a[top]);
        top--;
    }
}
void display()
{
    int i;
    if (top == -1)
    {
        printf("Stack is empty\n");
    }
    else
    {
        printf("Stack elements are:\n");
        for (i = top; i >= 0; i--)
        {
            printf("%d\n", a[i]);
        }
    }
}
void peek()
{
    if (top == -1)
    {
        printf("Stack is empty\n");
    }
    else
    {
        printf("Top element is: %d\n", a[top]);       
    }
}
int main()
{
    int choice;
    while (1)
    {
        printf("\n -- Stack Operations --\n");
        printf("1. Push\n");
        printf("2. Pop\n");
        printf("3. Display\n");
        printf("4. Peek\n");
        printf("5. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);
        switch (choice)
        {
            case 1:
                push();
                break;
            case 2:
                pop();
                break;
            case 3:
                display();
                break;
            case 4:
                peek();
                break;
            case 5:
                exit(0);
            default:
printf("Invalid choice\n");
        }
    }
    return 0;
}
